# ==============================================================================
# Marko Polo - Environment Variables Configuration
# ==============================================================================

# MongoDB Connection String:
# - Local MongoDB instance: mongodb://127.0.0.1:27017/markdown_notes
# - MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/markdown_notes?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/markdown_notes

# JWT Authentication Secret Key:
# Must be at least 32 characters long.
# Generate in bash/PowerShell with: openssl rand -base64 32
# or node: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=your_super_secret_auth_token_key_minimum_32_characters_long

# Canonical Application Base URL:
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

